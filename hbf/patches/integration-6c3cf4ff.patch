+// Dedicated scratch directory for simulator temp files, so mkstemp
+// artifacts (e.g. _app_cuda_version_*, _cuobjdump_list_ptx_*) never
+// litter the working directory. Honors $HBF_TMPDIR, defaults to
+// ./.hbf_tmp (created on first use).
+static void hbf_create_scratch_dir(const char *path) {
+  if (path == NULL || path[0] == '\0' || strlen(path) >= PATH_MAX) {
+    fprintf(stderr, "HBF: invalid scratch directory path\n");
+    exit(1);
+  }
+  for (const char *cursor = path; *cursor != '\0'; ++cursor) {
+    if (!isalnum((unsigned char)*cursor) && *cursor != '/' &&
+        *cursor != '.' && *cursor != '_' && *cursor != '-') {
+      fprintf(stderr, "HBF: unsafe scratch directory path: %s\n", path);
+      exit(1);
+    }
+  }
+  char current[PATH_MAX];
+  snprintf(current, sizeof(current), "%s", path);
+  for (char *cursor = current + 1; *cursor != '\0'; ++cursor) {
+    if (*cursor != '/') continue;
+    *cursor = '\0';
+    if (mkdir(current, 0700) != 0 && errno != EEXIST) {
+      fprintf(stderr, "HBF: cannot create scratch directory %s: %s\n",
+              current, strerror(errno));
+      exit(1);
+    }
+    *cursor = '/';
+  }
+  if (mkdir(current, 0700) != 0 && errno != EEXIST) {
+    fprintf(stderr, "HBF: cannot create scratch directory %s: %s\n",
+            current, strerror(errno));
+    exit(1);
+  }
+  struct stat info;
+  if (stat(current, &info) != 0 || !S_ISDIR(info.st_mode)) {
+    fprintf(stderr, "HBF: scratch path is not a directory: %s\n", current);
+    exit(1);
+  }
+}
+
+static const char *hbf_scratch_dir() {
+  static std::string dir;
+  if (dir.empty()) {
+    const char *env = getenv("HBF_TMPDIR");
+    dir = (env && env[0]) ? env : ".hbf_tmp";
+    hbf_create_scratch_dir(dir.c_str());
+  }
+  return dir.c_str();
+}
+
+static int hbf_mkstemp(char *path_template) {
+  int fd = mkstemp(path_template);
+  if (fd < 0) {
+    fprintf(stderr, "HBF: cannot create temporary file %s: %s\n",
+            path_template, strerror(errno));
+    exit(1);
+  }
+  return fd;
+}
